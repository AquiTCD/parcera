# OpenAI API Key (Required for ChatGPT)
OPENAI_API_KEY=

# TTS Configuration (VOICEVOX Compatible API)
# Can be used with VOICEVOX, AivisSpeech, COEIROINK, etc.

# Base URL for the TTS engine API
# default: http://127.0.0.1:50021 (VOICEVOX)
# default: http://127.0.0.1:10101 (AivisSpeech)
TTS_API_URL=http://127.0.0.1:10101

# Speaker ID (Integer)
# Check your TTS application for the specific ID of the character you want to use.
# default: 46 (VOICEVOX: Sayo)
# default: 888753760 (AivisSpeech: Anneli)
TTS_SPEAKER_ID=888753760

# Google Cloud STT (Optional, if using Google Speech Recognition API key instead of default)
GOOGLE_API_KEY=
