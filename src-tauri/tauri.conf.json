{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parcera",
  "version": "0.11.0",
  "identifier": "Parcera",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:tauri",
    "beforeBuildCommand": "pnpm build:tauri"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "user",
        "title": "Parcera - User",
        "url": "index.html?type=user",
        "width": 400,
        "height": 400,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "resizable": true
      },
      {
        "label": "ai",
        "title": "Parcera - AI",
        "url": "index.html?type=ai",
        "width": 400,
        "height": 400,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../configs/settings.default.yaml": "configs/settings.default.yaml"
    }
  }
}
