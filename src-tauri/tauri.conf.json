{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parcera",
  "version": "0.14.3",
  "identifier": "Parcera",
  "build": {
    "frontendDist": "../dist/web",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "user",
        "title": "Parcera - User",
        "url": "index.html?type=user",
        "width": 400,
        "height": 400,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "resizable": true
      },
      {
        "label": "ai",
        "title": "Parcera - AI",
        "url": "index.html?type=ai",
        "width": 400,
        "height": 400,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {},
      "wix": {
        "upgradeCode": "2818B657-ED1A-4B94-BA70-EFB15D062029"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../configs/settings.default.yaml": "configs/settings.default.yaml",
      "../configs/system_vitals.yaml": "configs/system_vitals.yaml",
      "../prompts": "prompts",
      "../ui/resources/bin/python-runtime": "python-runtime",
      "../ui/resources/site-packages": "site-packages",
      "../src": "python_src"
    }
  }
}
